{
  "productName": "Markdown Live",
  "version": "3.1.0",
  "identifier": "com.uytran.markdownlive",
  "build": {
    "frontendDist": "../src",
    "devUrl": null,
    "beforeDevCommand": "node scripts/sync-version.js",
    "beforeBuildCommand": "node scripts/sync-version.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Markdown Live",
        "width": 1280,
        "height": 700,
        "minWidth": 720,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http:; frame-src 'self' data: blob:; child-src 'self' data: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md"],
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Editor"
      },
      {
        "ext": ["markdown", "mdown", "mkd"],
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Editor"
      },
      {
        "ext": ["txt"],
        "name": "Text",
        "description": "Plain text document",
        "role": "Editor"
      }
    ]
  }
}